<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <!-- Logo / Title area -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="🌉"
            android:textSize="64sp"
            android:gravity="center"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Setu"
            android:textSize="42sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.05"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Bridge Languages. No Internet."
            android:textSize="14sp"
            android:textColor="@color/accent_orange"
            android:letterSpacing="0.02"/>

        <!-- Divider -->
        <View
            android:layout_width="48dp"
            android:layout_height="2dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp"
            android:background="@color/accent_orange"/>

        <!-- Role selection -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Choose your role"
            android:textSize="16sp"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="12dp"
            android:letterSpacing="0.08"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2">

            <Button
                android:id="@+id/btnHost"
                style="@style/RoleButton"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="📡 HOST\nWait for connection"
                android:minHeight="80dp"/>

            <Button
                android:id="@+id/btnJoiner"
                style="@style/RoleButton"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="🔍 JOINER\nFind &amp; connect"
                android:minHeight="80dp"/>

        </LinearLayout>

        <!-- Language selection -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Your display language"
            android:textSize="16sp"
            android:textColor="@color/text_secondary"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="12dp"
            android:letterSpacing="0.08"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2">

            <Button
                android:id="@+id/btnLangEnglish"
                style="@style/LangButton"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="🇬🇧 English"/>

            <Button
                android:id="@+id/btnLangHindi"
                style="@style/LangButton"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="🇮🇳 हिन्दी"/>

        </LinearLayout>

        <!-- Continue button -->
        <Button
            android:id="@+id/btnContinue"
            style="@style/PrimaryButton"
            android:layout_marginTop="32dp"
            android:text="Continue →"
            android:enabled="false"
            android:alpha="0.5"/>

        <!-- Utility buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp"
            android:weightSum="2">

            <Button
                android:id="@+id/btnModelSetup"
                style="@style/SecondaryButton"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="⚙️ Models"
                android:textSize="13sp"/>

            <Button
                android:id="@+id/btnTranslationTest"
                style="@style/SecondaryButton"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="🧪 Test"
                android:textSize="13sp"/>

        </LinearLayout>

        <!-- Offline badge -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="✈️  Works 100% offline — airplane mode OK"
            android:textSize="12sp"
            android:textColor="@color/text_hint"
            android:gravity="center"/>

    </LinearLayout>
</ScrollView>
