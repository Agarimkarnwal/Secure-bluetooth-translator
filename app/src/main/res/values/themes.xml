<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base app theme — dark, no action bar (we use Toolbar manually) -->
    <style name="Theme.Setu" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/accent_orange</item>
        <item name="colorPrimaryDark">@color/accent_orange_dark</item>
        <item name="colorAccent">@color/accent_orange</item>
        <item name="android:windowBackground">@color/bg_primary</item>
        <item name="android:statusBarColor">@color/bg_surface</item>
        <item name="android:navigationBarColor">@color/bg_primary</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_hint</item>
        <item name="toolbarStyle">@style/SetuToolbar</item>
    </style>

    <style name="SetuToolbar" parent="Widget.MaterialComponents.Toolbar">
        <item name="android:background">@color/bg_surface</item>
        <item name="android:elevation">4dp</item>
        <item name="titleTextColor">@color/text_primary</item>
    </style>

    <!-- Role selection buttons -->
    <style name="RoleButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingBottom">16dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:gravity">center</item>
        <item name="strokeColor">@color/selector_role_stroke</item>
        <item name="strokeWidth">2dp</item>
        <item name="android:background">@drawable/bg_role_button</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="cornerRadius">12dp</item>
    </style>

    <!-- Language selection buttons -->
    <style name="LangButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="strokeColor">@color/selector_role_stroke</item>
        <item name="strokeWidth">2dp</item>
        <item name="android:background">@drawable/bg_role_button</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="cornerRadius">8dp</item>
    </style>

    <!-- Primary action button -->
    <style name="PrimaryButton" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/text_on_accent</item>
        <item name="backgroundTint">@color/accent_orange</item>
        <item name="cornerRadius">12dp</item>
    </style>

    <!-- Secondary button -->
    <style name="SecondaryButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="strokeColor">@color/accent_orange</item>
        <item name="android:textColor">@color/accent_orange</item>
        <item name="cornerRadius">8dp</item>
    </style>

    <!-- Send button (icon style) -->
    <style name="SendButton" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="backgroundTint">@color/accent_orange</item>
        <item name="cornerRadius">24dp</item>
        <item name="android:padding">0dp</item>
    </style>

    <!-- Bottom sheet style -->
    <style name="BottomSheetStyle" parent="Theme.MaterialComponents.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/AppBottomSheet</item>
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>

    <style name="AppBottomSheet" parent="Widget.MaterialComponents.BottomSheet">
        <item name="android:background">@drawable/bg_bottom_sheet</item>
        <item name="behavior_peekHeight">400dp</item>
    </style>
</resources>
